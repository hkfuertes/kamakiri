#!/sbin/sh
# Update an existing Kamakiri installation; never install preloader/LK/TZ/RPMB/GPT.
set -eu
OUTFD=$2
ZIP=$3
BOOT0=/dev/block/mmcblk0boot0
LK=/dev/block/mmcblk0p1
BOOT=/dev/block/mmcblk0p4
SYS=/sys/class/block
RO=$SYS/mmcblk0boot0/force_ro
LK_SIZE=__LK_SIZE__
LK_SHA=__LK_SHA256__
PAYLOAD_SIZE=__PAYLOAD_SIZE__
PAYLOAD_SHA=__PAYLOAD_SHA256__
FLASH_BOOT=__FLASH_BOOT__
BOOT_SIZE=__BOOT_SIZE__
BOOT_SHA=__BOOT_SHA256__
RESTORE_RO=

ui_print() { printf 'ui_print %s\nui_print\n' "$*" > "/proc/self/fd/$OUTFD"; }
abort() { ui_print "! $*"; exit 1; }
file_sha256() { sha256sum "$1" | awk '{print $1}'; }

[ -n "$(getprop ro.twrp.version)" ] || abort "Install from TWRP, not Android/OpenWrt."
case "$(getprop ro.product.device)" in sheldon|sheldonp) ;; *) abort "Sheldon only." ;; esac
for tool in sha256sum head unzip toybox; do
    command -v "$tool" >/dev/null 2>&1 || abort "$tool is required."
done
[ -b "$BOOT0" ] && [ -b "$LK" ] || abort "Cannot find boot0/LK devices."
read -r sector_size < "$SYS/mmcblk0/queue/logical_block_size"
read -r boot0_sectors < "$SYS/mmcblk0boot0/size"
[ "$sector_size" = 512 ] && [ "$boot0_sectors" = 8192 ] || abort "Unexpected boot0 geometry."
read -r old_ro < "$RO"
case "$old_ro" in 0|1) ;; *) abort "Cannot identify force_ro setting." ;; esac
TMP=$(mktemp -d /tmp/kamakiri-arm64.XXXXXX) || abort "Cannot create temporary directory."
cleanup() {
    result=$?
    if [ -n "$RESTORE_RO" ]; then
        if ! printf '%s\n' "$RESTORE_RO" > "$RO"; then
            ui_print "! Could not restore boot0 force_ro."
            result=1
        fi
    fi
    rm -rf "$TMP"
    exit "$result"
}
trap cleanup 0
trap 'exit 1' HUP INT TERM
unzip -o "$ZIP" arm64/payload.bin -d "$TMP" >/dev/null || abort "Cannot extract payload."
[ "$PAYLOAD_SIZE" -gt 0 ] && [ "$PAYLOAD_SIZE" -le 524288 ] && [ "$((PAYLOAD_SIZE % 512))" -eq 0 ] \
    || abort "Invalid payload size."
[ "$(wc -c < "$TMP/arm64/payload.bin")" -eq "$PAYLOAD_SIZE" ] || abort "Payload size mismatch."
[ "$(file_sha256 "$TMP/arm64/payload.bin")" = "$PAYLOAD_SHA" ] || abort "Payload hash mismatch."

# Hash exactly LK_SIZE bytes: sector padding is not part of bin/lk.bin.
LK_BLOCKS=$(((LK_SIZE + 511) / 512))
toybox dd if="$LK" of="$TMP/lk-sectors.bin" bs=512 count="$LK_BLOCKS" 2>/dev/null || abort "Cannot read LK."
head -c "$LK_SIZE" "$TMP/lk-sectors.bin" > "$TMP/lk.bin" || abort "Cannot trim LK read."
[ "$(wc -c < "$TMP/lk.bin")" -eq "$LK_SIZE" ] && [ "$(file_sha256 "$TMP/lk.bin")" = "$LK_SHA" ] \
    || abort "LK mismatch; this payload is pinned to Kamakiri's verified LK. No writes performed."

if [ "$FLASH_BOOT" = 1 ]; then
    [ -b "$BOOT" ] || abort "Boot partition not found."
    read -r boot_blocks < "$SYS/mmcblk0p4/size"
    [ "$BOOT_SIZE" -gt 0 ] && [ "$BOOT_SIZE" -le "$((boot_blocks * 512))" ] || abort "Boot image does not fit."
    unzip -o "$ZIP" arm64/boot-arm64-kamakiri.img -d "$TMP" >/dev/null || abort "Cannot extract boot image."
    [ "$(wc -c < "$TMP/arm64/boot-arm64-kamakiri.img")" -eq "$BOOT_SIZE" ] \
        && [ "$(file_sha256 "$TMP/arm64/boot-arm64-kamakiri.img")" = "$BOOT_SHA" ] || abort "Boot image hash/size mismatch."
    read -r devnum < "$SYS/mmcblk0p4/dev"
    mounted=$(awk -v n="$devnum" '$3 == n || $5 ~ /^\/boot(\/|$)/ { print $5; exit }' /proc/self/mountinfo) \
        || abort "Cannot inspect boot mounts."
    [ -z "$mounted" ] || abort "Unmount Boot first."
fi

SAVED=$(mktemp -d /tmp/kamakiri-boot0-backup.XXXXXX) || abort "Cannot create backup directory."
ui_print "Saving current boot0 to $SAVED/boot0.bin (ADB pull before reboot to keep it)."
toybox dd if="$BOOT0" of="$SAVED/boot0.bin" bs=512 count="$boot0_sectors" 2>/dev/null || abort "Cannot back up boot0."
[ "$(wc -c < "$SAVED/boot0.bin")" -eq "$((boot0_sectors * 512))" ] || abort "Incomplete boot0 backup."
if [ "$FLASH_BOOT" = 1 ]; then
    toybox dd if="$BOOT" of="$SAVED/boot.img" bs=512 count="$boot_blocks" 2>/dev/null || abort "Cannot back up boot image."
    [ "$(wc -c < "$SAVED/boot.img")" -eq "$((boot_blocks * 512))" ] || abort "Incomplete boot image backup."
fi

RESTORE_RO=$old_ro
printf '0\n' > "$RO" || abort "Cannot unlock boot0 writes."
# Backup slot first; never reach the primary slot if its write/readback fails.
for block in 4096 1024; do
    ui_print "Updating payload at boot0 LBA $block..."
    toybox dd if="$TMP/arm64/payload.bin" of="$BOOT0" bs=512 seek="$block" conv=notrunc 2>/dev/null \
        || abort "Payload write failed at LBA $block; stopping. Backup: $SAVED"
    sync || abort "Payload sync failed; stopping. Backup: $SAVED"
    toybox dd if="$BOOT0" of="$TMP/readback.bin" bs=512 skip="$block" count="$((PAYLOAD_SIZE / 512))" 2>/dev/null \
        || abort "Cannot read back payload at LBA $block."
    [ "$(file_sha256 "$TMP/readback.bin")" = "$PAYLOAD_SHA" ] || abort "Payload readback failed at LBA $block; stopping."
done
printf '%s\n' "$old_ro" > "$RO" || abort "Cannot restore boot0 force_ro."
RESTORE_RO=

if [ "$FLASH_BOOT" = 1 ]; then
    ui_print "Updating ARM64 boot image..."
    toybox dd if="$TMP/arm64/boot-arm64-kamakiri.img" of="$BOOT" conv=notrunc 2>/dev/null || abort "Boot write failed. Backup: $SAVED"
    sync || abort "Boot sync failed."
    toybox dd if="$BOOT" of="$TMP/boot-sectors.bin" bs=512 count="$(((BOOT_SIZE + 511) / 512))" 2>/dev/null || abort "Cannot read back boot."
    head -c "$BOOT_SIZE" "$TMP/boot-sectors.bin" > "$TMP/boot.bin" || abort "Cannot trim boot read."
    [ "$(file_sha256 "$TMP/boot.bin")" = "$BOOT_SHA" ] || abort "Boot readback failed. Backup: $SAVED"
else
    ui_print "Boot image/ROM untouched; only the ARM32/ARM64 selector was updated."
fi
ui_print "Done. GPT, preloader, LK, TZ, RPMB and recovery were not changed."
ui_print "No automatic reboot. Keep the backup with ADB before rebooting."
