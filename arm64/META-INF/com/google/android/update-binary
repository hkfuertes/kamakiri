#!/sbin/sh -x
# kamakiri ARM64 updater
# Based on kamakiri updater (C) 2019 k4y0z @ xda-developers
# Updates ONLY: lk-payload (boot0) + injected ARM64 boot image.
# Assumes original kamakiri is already installed (downgraded lk/tz, rpmb zeroed).

PAYLOAD_BLOCK=1024
PAYLOAD_BACKUP_BLOCK=4096
BOOT_PART=boot            # boot | recovery (selector works for both)

LK_SHA256=__LK_SHA256__   # filled by makedist-arm64.sh from bin/lk.bin
LK_BLOCKS=__LK_BLOCKS__

PART_PREFIX=/dev/block/platform/soc/11230000.mmc

# detect whether in boot mode
getprop | grep zygote | grep -q running && bootMode=true || bootMode=false

# Default permissions
umask 022

ui_print() {
  $bootMode && echo -e "$1" || echo -e "ui_print $1\nui_print" >> /proc/self/fd/$outFD
}

if $bootMode; then
  ui_print " "
  ui_print "(!) Boot mode install is not supported"
  ui_print "- Install from recovery mode"
  ui_print " "
  exit 1
fi

grep_prop() {
  REGEX="s/^$1=//p"
  shift
  FILES=$@
  [ -z "$FILES" ] && FILES='/default.prop'
  sed -n "$REGEX" $FILES 2>/dev/null | head -n 1
}

check_product() {
  product=$(grep_prop ro.product.device)

  if [ "$product" != "${1}" ] ; then
    ui_print "This is only for the \"${1}\"${2}, your device is a \"${product}\""
    exit 1
  fi
}

setenforce 0

outFD=$2
ZIP="$3"

readlink /proc/$$/fd/$outFD 2>/dev/null | grep /tmp >/dev/null
if [ "$?" -eq "0" ]; then
  outFD=0

  for FD in `ls /proc/$$/fd`; do
  readlink /proc/$$/fd/$FD 2>/dev/null | grep pipe >/dev/null
  if [ "$?" -eq "0" ]; then
    ps | grep " 3 $FD " | grep -v grep >/dev/null
    if [ "$?" -eq "0" ]; then
    outFD=$FD
    break
    fi
  fi
  done
fi

check_product "sheldon" " - Amazon FireTV Stick 3rd Gen (sheldon/p) - "

TMPDIR=/dev/tmp
INSTALLER=$TMPDIR/install

rm -rf $TMPDIR 2>/dev/null
mkdir -p $INSTALLER 2>/dev/null

unzip -o "$ZIP" 'arm64/*' -d $INSTALLER >&2

abort() { ui_print "$1"; exit 1; }

##########################################################################################
# Main
##########################################################################################

ui_print " "
ui_print "kamakiri ARM64 updater"

command -v sha256sum >/dev/null 2>&1 || abort "! sha256sum not available, cannot verify LK"

ui_print "- verifying LK (g_is_64bit_kernel is pinned to this LK)"
dd if=${PART_PREFIX}/by-name/lk bs=512 count=${LK_BLOCKS} 2>/dev/null | sha256sum | grep -q "^${LK_SHA256}" \
  || abort "! LK mismatch: expected ${LK_SHA256}. DO NOT flash this payload on another LK."

ui_print "- verifying image"
[ "$(dd if=${INSTALLER}/arm64/boot-arm64-kamakiri.img bs=1 skip=1024 count=8 2>/dev/null)" = "ANDROID!" ] \
  || abort "! bad image: no ANDROID! header at 0x400"
[ "$(dd if=${INSTALLER}/arm64/boot-arm64-kamakiri.img bs=1 skip=1088 count=22 2>/dev/null)" = "bootopt=64S3,32N2,64N2" ] \
  || abort "! bad image: cmdline must start with bootopt=64S3,32N2,64N2"

echo 0 > /sys/block/mmcblk0boot0/force_ro

ui_print "- updating lk-payload"
dd if=${INSTALLER}/arm64/payload.bin of=/dev/block/mmcblk0boot0 bs=512 seek=${PAYLOAD_BLOCK}

ui_print "- updating lk-payload backup"
dd if=${INSTALLER}/arm64/payload.bin of=/dev/block/mmcblk0boot0 bs=512 seek=${PAYLOAD_BACKUP_BLOCK}

echo 1 > /sys/block/mmcblk0boot0/force_ro

ui_print "- flashing ARM64 image to ${BOOT_PART}"
dd if=${INSTALLER}/arm64/boot-arm64-kamakiri.img of=${PART_PREFIX}/by-name/${BOOT_PART}

sync

ui_print "- done"
ui_print "- note: first ARM64 boot is experimental (SMC/PSCI/SMP unvalidated)"
ui_print " "

exit 0
